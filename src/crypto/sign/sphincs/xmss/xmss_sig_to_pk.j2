#include <stdint.h>
#include <string.h>
#include <crypto/sign/sphincs/params/common.h>
#include <crypto/sign/sphincs/adrs.h>
#include <crypto/sign/sphincs/hash.h>
#include <crypto/sign/sphincs/wots.h>
#include <crypto/sign/sphincs/xmss.h>

/* pk_seed: SPHINCS_N bytes, no assumptions, no data dependence
   layer: No assumptions, no data dependence
   tree_addr_swapped: No assumptions, no data dependence
   keypair: No assumptions, control flow dependence (note that keypair >= 2 ^ SPHINCS_XH will not induce UB, unlike xmss_sign_and_pk)
   msg: SPHINCS_N bytes, no assumptions, control flow dependence due to call to wots_sig_to_pk
   sig: (SPHINCS_WLEN + SPHINCS_XH) * SPHINCS_N bytes, no assumptions, no data dependence
   pk_out: SPHINCS_N bytes

   External calls:
   wots_sig_to_pk: 1 time, no assumptions, no output data dependence
   hash_h: SPHINCS_XH times, no assumptions, no output data dependence
 */

{% for inst in insts %}

#include <crypto/sign/sphincs/params/params_{{ inst.secbit }}_{{ inst.hash }}.h>

void sphincs_{{ inst.secbit }}_{{ inst.hash }}_xmss_sig_to_pk (const unsigned char * pk_seed, uint8_t layer, uint64_t tree_addr_swapped, uint16_t keypair, const unsigned char * msg, const unsigned char * sig, unsigned char * pk_out) {
  uint32_t adrs[8];
  sphincs_adrs_set_layer (adrs, layer);
  sphincs_adrs_set_tree_addr_swapped (adrs, tree_addr_swapped);
  sphincs_adrs_set_keypair_swapped (adrs, 0);
  sphincs_adrs_set_type (adrs, SPHINCS_TREE);

  unsigned char tmp1[SPHINCS_N], tmp2[SPHINCS_N];
  sphincs_wots_sig_to_pk (pk_seed, layer, tree_addr_swapped, __builtin_bswap16 (keypair), msg, sig, tmp1);

  for (uint32_t i = 1; i <= SPHINCS_XH; ++i) {
    sphincs_adrs_set_word6 (adrs, i << 24);
    sphincs_adrs_set_word7 (adrs, ((uint32_t) (keypair >> i)) << 24);
    if (keypair & (1u << (i - 1))) {
      if (i & 1) {
	sphincs_hash_h (pk_seed, adrs, sig + (SPHINCS_WLEN + i - 1) * SPHINCS_N, tmp1, tmp2);
      } else {
	sphincs_hash_h (pk_seed, adrs, sig + (SPHINCS_WLEN + i - 1) * SPHINCS_N, tmp2, tmp1);
      }
    } else {
      if (i & 1) {
	sphincs_hash_h (pk_seed, adrs, tmp1, sig + (SPHINCS_WLEN + i - 1) * SPHINCS_N, tmp2);
      } else {
	sphincs_hash_h (pk_seed, adrs, tmp2, sig + (SPHINCS_WLEN + i - 1) * SPHINCS_N, tmp1);
      }
    }
  }

  if (SPHINCS_XH & 1) {
    memcpy (pk_out, tmp2, SPHINCS_N);
  } else {
    memcpy (pk_out, tmp1, SPHINCS_N);
  }
}

#include <crypto/sign/sphincs/params/clear.h>

{% endfor %}
