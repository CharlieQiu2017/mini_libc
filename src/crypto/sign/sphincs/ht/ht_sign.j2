#include <stdint.h>
#include <crypto/sign/sphincs/params/common.h>
#include <crypto/sign/sphincs/adrs.h>
#include <crypto/sign/sphincs/xmss.h>
#include <crypto/sign/sphincs/ht.h>

/* pk_seed: SPHINCS_N bytes, no assumptions, no data dependence
   sk_seed: SPHINCS_N bytes, no assumptions, no data dependence
   idx_tree: No assumptions, control flow dependence due to calls to xmss_sign_and_pk
   idx_leaf: 0 <= idx_leaf < 2 ^ SPHINCS_XH, control flow dependence due to calls to xmss_sign_and_pk
   msg: SPHINCS_N bytes, no assumptions, control flow dependence due to calls to xmss_sign_and_pk
   out: SPHINCS_D * (SPHINCS_WLEN + SPHINCS_XH) * SPHINCS_N bytes

   External calls:
   xmss_sign_and_pk: SPHINCS_D times, no assumptions, control flow dependence on output data due to subsequent calls to xmss_sign_and_pk
 */

{% for inst in insts %}

#include <crypto/sign/sphincs/params/params_{{ inst.secbit }}_{{ inst.hash }}.h>

void sphincs_{{ inst.secbit }}_{{ inst.hash }}_ht_sign (const unsigned char * pk_seed, const unsigned char * sk_seed, uint64_t idx_tree, uint16_t idx_leaf, const unsigned char * msg, unsigned char * out) {
  unsigned char tmp1[SPHINCS_N], tmp2[SPHINCS_N];
  for (uint32_t i = 0; i < SPHINCS_D; ++i) {
    if (i & 1) {
      sphincs_xmss_sign_and_pk (pk_seed, sk_seed, i, __builtin_bswap64 (idx_tree), idx_leaf, msg, out + i * (SPHINCS_WLEN + SPHINCS_XH) * SPHINCS_N, tmp1);
      msg = tmp1;
    } else {
      sphincs_xmss_sign_and_pk (pk_seed, sk_seed, i, __builtin_bswap64 (idx_tree), idx_leaf, msg, out + i * (SPHINCS_WLEN + SPHINCS_XH) * SPHINCS_N, tmp2);
      msg = tmp2;
    }

    idx_leaf = idx_tree & ((1u << SPHINCS_XH) - 1u);
    idx_tree >>= SPHINCS_XH;
  }
}

#include <crypto/sign/sphincs/params/clear.h>

{% endfor %}
