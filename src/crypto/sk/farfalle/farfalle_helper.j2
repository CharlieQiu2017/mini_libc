#include <stdint.h>
#include <string.h>
#include <crypto/hash/keccak/keccak_p.h>
#include <crypto/sk/farfalle/farfalle.h>
#include <crypto/sk/farfalle/farfalle_helper.h>

{% for inst in insts %}

#include <crypto/sk/farfalle/params/{{ inst.name }}.h>

void farfalle_{{ inst.name }}_add_string_part (struct farfalle_{{ inst.name }}_state * st, struct farfalle_{{ inst.name }}_helper_state * hst, const unsigned char * str, size_t str_len) {
  uint32_t off = hst->offset_ctr;
  unsigned char * p_ptr = (unsigned char *) hst->p;

  if (str_len < FARFALLE_PERM_LEN && str_len + off < FARFALLE_PERM_LEN) {

    memxor (p_ptr + off, str, str_len);
    hst->offset_ctr += str_len;

  } else {

    uint32_t r = FARFALLE_PERM_LEN - off;
    memxor (p_ptr + off, str, r);

    farfalle_perm_c (hst->p);

    memxor (st->sum, hst->p, FARFALLE_PERM_LEN);

    str += r;
    str_len -= r;
    farfalle_roll_c (st->k);

    while (str_len >= FARFALLE_PERM_LEN) {
      memcpy (hst->p, st->k, FARFALLE_PERM_LEN);
      memxor (hst->p, str, FARFALLE_PERM_LEN);

      farfalle_perm_c (hst->p);

      memxor (st->sum, hst->p, FARFALLE_PERM_LEN);

      str += FARFALLE_PERM_LEN;
      str_len -= FARFALLE_PERM_LEN;
      farfalle_roll_c (st->k);
    }

    memcpy (hst->p, st->k, FARFALLE_PERM_LEN);
    memxor (hst->p, str, str_len);

    hst->offset_ctr = str_len;

  }
}

void farfalle_{{ inst.name }}_finalize_string (struct farfalle_{{ inst.name }}_state * st, struct farfalle_{{ inst.name }}_helper_state * hst) {
  uint32_t off = hst->offset_ctr;
  unsigned char * p_ptr = (unsigned char *) hst->p;

  p_ptr[off] ^= 1; /* Simulate pad10* */

  farfalle_perm_c (hst->p);

  memxor (st->sum, hst->p, FARFALLE_PERM_LEN);

  farfalle_roll_c (st->k);
  farfalle_roll_c (st->k);
}

#include <crypto/sk/farfalle/params/clear.h>

{% endfor %}
